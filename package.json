{
  "name": "tadum",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc -b --noEmit",
    "lint": "eslint . --max-warnings=0 && stylelint \"src/**/*.css\"",
    "lint:rtl": "node scripts/lint-rtl.mjs",
    "lint:i18n": "i18next-cli extract --ci --dry-run --quiet && node scripts/lint-i18n-tov.mjs",
    "lint:gitlab-ci": "node scripts/lint-gitlab-ci.mjs",
    "test": "vitest run --project unit",
    "test:e2e": "playwright test --grep-invert @screenshot",
    "test:e2e:smoke": "playwright test --project=android-chrome --grep @smoke",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:stories": "vitest run --project storybook",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts --project=desktop-chrome",
    "screenshots:update": "docker run --rm --ipc=host -v \"$PWD:/work\" -w /work mcr.microsoft.com/playwright:v1.63.0-noble sh -c \"npm i -g pnpm@10.28.0 && pnpm install --frozen-lockfile --config.engine-strict=false && pnpm build && pnpm screenshots\"",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --quiet",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "deps:graph": "depcruise src --config .dependency-cruiser.cjs --include-only \"^src\" --output-type mermaid > docs/architecture/deps.mmd",
    "knip": "knip",
    "jscpd": "jscpd",
    "check:events": "node scripts/check-events.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:first-chunk": "node scripts/check-first-chunk.mjs",
    "check:demo-excluded": "node scripts/check-demo-excluded.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:claude": "node scripts/check-claude.mjs",
    "contract:md": "node scripts/contract-md.mjs",
    "i18n:extract": "i18next-cli extract",
    "size": "size-limit",
    "lhci": "lhci autorun",
    "verify": "pnpm typecheck && pnpm lint && pnpm lint:rtl && pnpm lint:gitlab-ci && pnpm deps:check && pnpm knip && pnpm jscpd && pnpm lint:i18n && pnpm check:events && pnpm contract:md --check && pnpm check:contrast && pnpm check:docs && pnpm check:claude && pnpm test && pnpm storybook:build && pnpm test:stories && pnpm build && pnpm check:first-chunk && pnpm test:e2e:smoke && pnpm check:demo-excluded",
    "release:proto": "node scripts/release-proto.mjs",
    "deploy:preview": "pnpm build && wrangler deploy",
    "prepare": "husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "workerd",
      "sharp"
    ],
    "overrides": {
      "basic-ftp": ">=6.2.1"
    }
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@remixicon/react": "4.9.0",
    "@tanstack/react-query": "5.106.0",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "i18next": "26.7.1",
    "input-otp": "1.5.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.12",
    "shadcn": "4.23.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "14.3.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/router-cli": "1.167.46",
    "@tanstack/router-plugin": "1.168.48",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/ui": "5.1.0",
    "ajv": "8.20.0",
    "culori": "4.0.2",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.1",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-rtl-friendly": "0.5.1",
    "eslint-plugin-storybook": "10.6.5",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "i18next-cli": "1.83.0",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "lint-staged": "17.6.0",
    "playwright": "1.63.0",
    "size-limit": "14.3.0",
    "storybook": "10.6.5",
    "stylelint": "18.0.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.1.0",
    "workbox-window": "7.4.1",
    "wrangler": "4.157.0",
    "yaml": "2.9.1"
  }
}

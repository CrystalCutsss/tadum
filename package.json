{
  "name": "tadum",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc -b --noEmit",
    "deploy:preview": "pnpm build && wrangler deploy",
    "verify": "pnpm typecheck && pnpm lint && pnpm deps:check && pnpm lint:i18n && pnpm test && pnpm build",
    "lint": "eslint . --max-warnings=0",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "deps:graph": "depcruise src --config .dependency-cruiser.cjs --include-only \"^src\" --output-type mermaid > docs/architecture/deps.mmd",
    "test": "vitest run",
    "i18n:extract": "i18next-cli extract",
    "lint:i18n": "i18next-cli extract --ci --dry-run --quiet && node scripts/lint-i18n-tov.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "workerd",
      "sharp"
    ]
  },
  "dependencies": {
    "@tanstack/react-query": "5.106.0",
    "@tanstack/react-router": "1.170.46",
    "i18next": "26.7.1",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/router-cli": "1.167.46",
    "@tanstack/router-plugin": "1.168.48",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.1",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-rtl-friendly": "0.5.1",
    "globals": "17.14.0",
    "i18next-cli": "1.83.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.1.0",
    "workbox-window": "7.4.1",
    "wrangler": "4.157.0"
  }
}

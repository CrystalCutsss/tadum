// Превью-воркер tadum: только статика из dist/, без Worker-скрипта (D-063).
// account_id не хранится здесь: деплой идёт из CI, wrangler берёт его из секрета CLOUDFLARE_ACCOUNT_ID (A-005).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tadum",
  "compatibility_date": "2026-11-05",
  // Превью веток (A-053): адреса <ветка>-tadum.<subdomain>.workers.dev; явно, чтобы деплой main их не выключал.
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}

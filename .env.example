# Пример переменных окружения. Скопировать в .env.local и поправить; секретов здесь нет и быть не должно.

# Базовый путь сборки: "/" локально и в проде, "/p/tadum/vN/" на витрине Proto.
VITE_BASE_PATH=/

# Адаптер портов данных: mock — фикстуры; http — каркас, методы бросают NotImplementedError.
VITE_API_MODE=mock

# Демо-панель и параметр ?persona=: 1 — витрина, 0 — прод.
VITE_DEMO_PANEL=1

# Провайдер аналитики (D-011, D-059): console | demo | posthog. На витрине — demo.
VITE_ANALYTICS=console

# Подпись версии на витрине, например v1.
VITE_PROTO_VERSION=

# Контакты поддержки для SupportBar.
VITE_SUPPORT_WHATSAPP=966579768881
VITE_SUPPORT_EMAIL=info@tadum.sa

# Куда ведёт «Подать заявку» для роли unknown.
VITE_LANDING_URL=https://tadum.sa
